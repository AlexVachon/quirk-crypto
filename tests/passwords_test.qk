use crypto
use test

define test_hash_and_verify() -> void {
    h := crypto.hash_password("correct horse")
    test.assert_true(h.startswith(r"$scrypt$ln=15,r=8,p=3$"), h)
    test.assert_true(crypto.verify_password("correct horse", h))
    test.assert_false(crypto.verify_password("correct horsf", h))
    test.assert_false(crypto.verify_password("", h))
    h2 := crypto.hash_password("correct horse")
    test.assert_true(h != h2)                                    // a new salt each time
    test.assert_true(crypto.verify_password("correct horse", h2))
    test.assert_false(crypto.needs_rehash(h))
    empty := crypto.hash_password("")                            // works for "", unicode
    test.assert_true(crypto.verify_password("", empty))
    u := crypto.hash_password("pässwörd ✓")
    test.assert_true(crypto.verify_password("pässwörd ✓", u))
    test.assert_false(crypto.verify_password("passwords", u))
}

define test_not_ours_or_tampered() -> void {
    for bad in ["", "plain", r"$scrypt$", r"$scrypt$ln=15,r=8,p=3$", r"$scrypt$ln=15,r=8,p=3$abc$",
                r"$scrypt$ln=99,r=8,p=3$c2FsdHNhbHRzYWx0c2FsdA$c2FsdHNhbHRzYWx0c2FsdHNhbHRzYWx0c2FsdA",
                r"$scrypt$ln=15,r=999,p=3$c2FsdHNhbHRzYWx0c2FsdA$c2FsdHNhbHRzYWx0c2FsdHNhbHRzYWx0c2FsdA",
                "5f4dcc3b5aa765d61d8327deb882cf99"] {
        test.assert_false(crypto.verify_password("password", String(bad)), String(bad))
        test.assert_true(crypto.needs_rehash(String(bad)), String(bad))
    }
    h := crypto.hash_password("secret")
    flipped := h.substring(0, h.length() - 2) + (h.endswith("A") ? "B" : "A") + h.substring(h.length() - 1, h.length())
    test.assert_false(crypto.verify_password("secret", flipped))      // one character of the hash changed
    weaker := h.replace("ln=15", "ln=14")
    test.assert_true(crypto.needs_rehash(weaker))                     // older, weaker settings
    test.assert_false(crypto.verify_password("secret", weaker))       // (and they're part of it)
}

define test_equal_and_random() -> void {
    test.assert_true(crypto.equal("abc", "abc"))
    test.assert_false(crypto.equal("abc", "abd"))
    test.assert_false(crypto.equal("abc", "abcd"))
    test.assert_true(crypto.equal("", ""))
    a := crypto.random_hex(16)
    test.assert_eq(a.length(), 32)
    test.assert_true(a != crypto.random_hex(16))
    test.assert_eq(crypto.uuid().length(), 36)
    test.assert_eq(crypto.uuid().substring(14, 15), "4")
}
